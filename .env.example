APP_NAME=Taja Multilingual Support Bot
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
MIN_MATCH_SCORE=0.52

# deterministic returns the reviewed answer exactly. openai enables constrained RAG generation.
ANSWER_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# memory is easiest locally; use redis for multiple production workers.
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=604800
REDIS_URL=redis://redis:6379/0

# Required for public webhook deployments.
WEBHOOK_SECRET=replace-with-a-long-random-secret
PSEUDONYMISATION_SALT=replace-with-a-different-long-random-secret

# Optional Gupshup WhatsApp delivery.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
GUPSHUP_API_URL=https://api.gupshup.io/sm/api/v1/msg

SUPPORT_URL=https://www.tajahq.com/contact
ALLOWED_ORIGINS=http://localhost:8000
